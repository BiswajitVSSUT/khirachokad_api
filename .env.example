PORT=8000
NODE_ENV=development

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://user:KcDb_2026!@localhost:5434/kc_db?schema=public"

JWT_SECRET="change-me"

# WhatsApp Cloud API (Meta app > WhatsApp > API Setup)
WHATSAPP_API_VERSION="v25.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="change-me-verify-token"
# App secret from Meta app > Settings > Basic. Leave empty only for local dev
# without signature verification.
WHATSAPP_APP_SECRET=""

# Optional: product retailer ID whose image is shown on the catalog card
WHATSAPP_CATALOG_THUMBNAIL_ID=""

# Approved "catalog" template containing a CATALOG button
# Template ID 4138468179623714, name "catalog", language "en"
WHATSAPP_CATALOG_TEMPLATE_NAME="catalog"
WHATSAPP_CATALOG_TEMPLATE_LANGUAGE="en"

# Meta product catalog used by scripts/catalog-sync.mjs
WHATSAPP_CATALOG_ID=""
WHATSAPP_BUSINESS_ID=""

# Catalog sync defaults (scripts/catalog-sync.mjs)
CATALOG_CURRENCY="INR"
CATALOG_BRAND="Khira Chokada"
CATALOG_STOREFRONT_URL="https://example.com"
CATALOG_DEFAULT_SHOP_ID=""
CATALOG_DEFAULT_EXPIRY="2099-12-31"

# Team number that receives new order alerts (country code, digits only)
TEAM_WHATSAPP_NUMBER=""

# Cloudinary media storage. Cloudinary's secure_url is reachable by Meta.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="kc-chat"
