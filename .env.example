PORT=8000
NODE_ENV=development

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://user:KcDb_2026!@localhost:5434/kc_db?schema=public"

JWT_SECRET="change-me"

# WhatsApp Cloud API (Meta app > WhatsApp > API Setup)
WHATSAPP_API_VERSION="v25.0"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="change-me-verify-token"
# App secret from Meta app > Settings > Basic. Leave empty only for local dev
# without signature verification.
WHATSAPP_APP_SECRET=""
# Every Meta media/catalog/message request is aborted after this duration.
WHATSAPP_REQUEST_TIMEOUT_MS="10000"
# Durable webhook work worker settings. Run the API and its worker near Postgres.
WHATSAPP_OUTBOX_POLL_MS="1000"
WHATSAPP_OUTBOX_RETRY_LIMIT="8"

# Optional: product retailer ID whose image is shown on the catalog card
WHATSAPP_CATALOG_THUMBNAIL_ID=""

# Published WhatsApp Flow used by the no-price order journey. The first screen
# defaults to PRODUCTS and should submit either product_items or qty_<retailerId>
# fields (for example qty_uwb6wnx0ej: "2").
WHATSAPP_ORDER_FLOW_ID=""
WHATSAPP_ORDER_FLOW_SCREEN_ID="PRODUCTS"

# Approved template with a CATALOG / "View catalog" button. The connected
# WhatsApp catalog handles product selection and emits an `order` webhook.
WHATSAPP_CATALOG_TEMPLATE_NAME="catalog"
WHATSAPP_CATALOG_TEMPLATE_LANGUAGE="en"

# Meta product catalog used by scripts/catalog-sync.mjs
WHATSAPP_CATALOG_ID=""
WHATSAPP_BUSINESS_ID=""

# Catalog sync defaults (scripts/catalog-sync.mjs)
CATALOG_CURRENCY="INR"
CATALOG_BRAND="Khira Chokada"
CATALOG_STOREFRONT_URL="https://example.com"
CATALOG_DEFAULT_SHOP_ID=""
CATALOG_DEFAULT_EXPIRY="2099-12-31"

# Team number that receives new order alerts (country code, digits only)
# One or more recipient numbers, separated by commas.
TEAM_WHATSAPP_NUMBER="919999999999,918888888888"

# Cloudinary media storage. Cloudinary's secure_url is reachable by Meta.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="kc-chat"
