generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationState {
  IDLE
  WELCOME_SENT
  BROWSING_PRODUCTS
  AWAITING_ADDRESS
  ORDER_PENDING_CONFIRMATION
  NEEDS_HUMAN
}

enum OrderStatus {
  AWAITING_ADDRESS
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
}

model customer {
  id             String         @id @default(uuid())
  whatsappNumber String         @unique
  name           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  conversations  conversation[]
  orders         order[]
}

model conversation {
  id         String            @id @default(uuid())
  customerId String            @unique
  state      ConversationState @default(IDLE)
  context    Json              @default("{}")
  updatedAt  DateTime          @default(now()) @updatedAt
  customer   customer          @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([state])
}

model order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerId      String
  status          OrderStatus @default(AWAITING_ADDRESS)
  customerName    String?
  deliveryAddress String?
  subtotal        Decimal     @default(0) @db.Decimal(12, 2)
  deliveryCharge  Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @default(0) @db.Decimal(12, 2)
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
  customer        customer    @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items           orderItem[]

  @@index([customerId])
  @@index([status])
}

model orderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  order       order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product     products @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model whatsappEvent {
  id            String   @id @default(uuid())
  eventKey      String   @unique
  messageId     String?
  field         String   @default("messages")
  eventType     String
  wabaId        String?
  phoneNumberId String?
  payload       Json?
  receivedAt    DateTime @default(now())

  @@index([field, receivedAt])
  @@index([messageId])
  @@index([wabaId])
}

model whatsappMessage {
  id              String    @id @default(uuid())
  waMessageId     String    @unique
  direction       String
  type            String?
  status          String?
  fromNumber      String?
  toNumber        String?
  customerId      String?
  errorCode       String?
  errorTitle      String?
  errorMessage    String?
  pricingCategory String?
  waTimestamp     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([customerId])
  @@index([fromNumber])
  @@index([toNumber])
  @@index([status])
}

model whatsappTemplate {
  id             String   @id @default(uuid())
  templateId     String   @unique
  name           String
  language       String?
  category       String?
  status         String?
  qualityScore   String?
  rejectedReason String?
  components     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([name])
  @@index([status])
}

model whatsappCallEvent {
  id         String    @id @default(uuid())
  callId     String
  event      String
  direction  String?
  fromNumber String?
  toNumber   String?
  status     String?
  startTime  DateTime?
  endTime    DateTime?
  duration   Int?
  payload    Json
  createdAt  DateTime  @default(now())

  @@index([callId])
  @@index([event])
}

model whatsappAccountState {
  id                             String    @id @default(uuid())
  subjectKey                     String    @unique
  wabaId                         String?
  phoneNumberId                  String?
  displayPhoneNumber             String?
  nameStatus                     String?
  nameRejectionReason            String?
  qualityRating                  String?
  throughputLevel                String?
  messagingLimit                 String?
  phoneNumberLimit               String?
  accountReviewStatus            String?
  accountUpdateEvent             String?
  businessVerificationStatus     String?
  officialBusinessAccountStatus  String?
  securityStatus                 String?
  lastEventField                 String?
  lastEventAt                    DateTime?
  lastEventPayload               Json?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @default(now()) @updatedAt

  @@index([wabaId])
  @@index([phoneNumberId])
}

model whatsappUserPreference {
  id              String   @id @default(uuid())
  waId            String   @unique
  marketingStatus String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model shop {
  id             String     @id @default(uuid())
  userId         String
  name           String
  description    String
  logo           String
  contactNumber  String
  contactNumber2 String?
  contactEmail   String
  postalCode     String?
  blockName      String?
  district       String?
  products       products[]
  reviews        review[]

  user admin @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model admin {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  avatar   String

  shops shop[]
}

model products {
  id          String @id @default(uuid())
  name        String
  description String
  price       String
  image       String

  sku               String? @unique
  whatsappProductId String? @unique
  unit              String  @default("bag")
  isActive          Boolean @default(true)
  stockQuantity     Int?

  shopId         String
  verificationId String   @unique
  expiryDate     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  shop       shop        @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderItems orderItem[]

  @@index([name, price])
}

model review {
  id            String   @id @default(uuid())
  revieweeName  String
  revieweeEmail String
  review        String
  rating        Int      @default(0)
  shopId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  shop          shop     @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([revieweeEmail, shopId])
  @@index([revieweeName, revieweeEmail, rating])
}
