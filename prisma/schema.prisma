generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationState {
  IDLE
  WELCOME_SENT
  BROWSING_PRODUCTS
  AWAITING_ADDRESS
  ORDER_PENDING_CONFIRMATION
  NEEDS_HUMAN
}

enum OrderStatus {
  PLACED
  AWAITING_ADDRESS
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  CANCELLED
  COMPLETED
  DELIVERED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_ADMIN
}

model customer {
  id             String         @id @default(uuid())
  whatsappNumber String         @unique
  name           String?
  profileImage   String?
  botBlacklist   Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
  conversations  conversation[]
  orders         order[]
  whatsappMessages whatsappMessage[]
}

model conversation {
  id         String            @id @default(uuid())
  customerId String            @unique
  state      ConversationState @default(IDLE)
  context    Json              @default("{}")
  updatedAt  DateTime          @default(now()) @updatedAt
  customer   customer          @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([state])
}

model order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerId      String
  status          OrderStatus @default(AWAITING_ADDRESS)
  customerName    String?
  deliveryAddress String?
  subtotal        Decimal     @default(0) @db.Decimal(12, 2)
  deliveryCharge  Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @default(0) @db.Decimal(12, 2)
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt
  customer        customer    @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  items           orderItem[]

  @@index([customerId])
  @@index([status])
}

model orderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String?
  catalogProductId String?
  productName String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  order       order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product     products? @relation(fields: [productId], references: [id], onDelete: Restrict)
  catalogProduct catalogProduct? @relation(fields: [catalogProductId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([catalogProductId])
}

model whatsappEvent {
  id            String   @id @default(uuid())
  eventKey      String   @unique
  messageId     String?
  field         String   @default("messages")
  eventType     String
  wabaId        String?
  phoneNumberId String?
  payload       Json?
  receivedAt    DateTime @default(now())

  @@index([field, receivedAt])
  @@index([messageId])
  @@index([wabaId])
}

model whatsappMessage {
  id              String    @id @default(uuid())
  waMessageId     String    @unique
  direction       String
  type            String?
  body            String?
  mediaUrl        String?
  caption         String?
  status          String?
  fromNumber      String?
  toNumber        String?
  customerId      String?
  errorCode       String?
  errorTitle      String?
  errorMessage    String?
  pricingCategory String?
  waTimestamp     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  customer        customer? @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([customerId])
  @@index([fromNumber])
  @@index([toNumber])
  @@index([status])
}

model whatsappTemplate {
  id             String   @id @default(uuid())
  templateId     String   @unique
  name           String
  language       String?
  category       String?
  status         String?
  qualityScore   String?
  rejectedReason String?
  components     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@index([name])
  @@index([status])
}

model whatsappCallEvent {
  id         String    @id @default(uuid())
  callId     String
  event      String
  direction  String?
  fromNumber String?
  toNumber   String?
  status     String?
  startTime  DateTime?
  endTime    DateTime?
  duration   Int?
  payload    Json
  createdAt  DateTime  @default(now())

  @@index([callId])
  @@index([event])
}

model whatsappAccountState {
  id                             String    @id @default(uuid())
  subjectKey                     String    @unique
  wabaId                         String?
  phoneNumberId                  String?
  displayPhoneNumber             String?
  nameStatus                     String?
  nameRejectionReason            String?
  qualityRating                  String?
  throughputLevel                String?
  messagingLimit                 String?
  phoneNumberLimit               String?
  accountReviewStatus            String?
  accountUpdateEvent             String?
  businessVerificationStatus     String?
  officialBusinessAccountStatus  String?
  securityStatus                 String?
  lastEventField                 String?
  lastEventAt                    DateTime?
  lastEventPayload               Json?
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @default(now()) @updatedAt

  @@index([wabaId])
  @@index([phoneNumberId])
}

model whatsappUserPreference {
  id              String   @id @default(uuid())
  waId            String   @unique
  marketingStatus String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model shop {
  id             String     @id @default(uuid())
  userId         String
  name           String
  description    String
  logo           String
  contactNumber  String
  contactNumber2 String?
  contactEmail   String
  postalCode     String?
  blockName      String?
  district       String?
  products       products[]
  reviews        review[]

  user admin @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model admin {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  avatar   String

  shops shop[]
  quickReplies quickReply[]
}

model quickReply {
  id        String   @id @default(uuid())
  shortcut  String
  text      String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  adminId   String?
  admin     admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model products {
  id          String @id @default(uuid())
  name        String
  description String
  price       String
  image       String

  sku               String? @unique
  whatsappProductId String? @unique
  unit              String  @default("bag")
  isActive          Boolean @default(true)
  stockQuantity     Int?

  shopId         String
  verificationId String   @unique
  expiryDate     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  shop       shop        @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderItems orderItem[]

  @@index([name, price])
}

/// Products synchronised with the Meta/WhatsApp catalog. These are kept
/// separate from the broader shop inventory so WhatsApp orders have a clear
/// source of truth and stable Meta retailer IDs.
model catalogProduct {
  id                String   @id @default(uuid())
  retailerId        String   @unique
  metaProductId     String?  @unique
  name              String
  description       String?
  image             String?
  price             Decimal  @db.Decimal(12, 2)
  currency          String   @default("INR")
  availability      String   @default("in stock")
  inventory         Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt
  orderItems        orderItem[]

  @@index([isActive, availability])
}

model review {
  id            String   @id @default(uuid())
  revieweeName  String
  revieweeEmail String
  review        String
  rating        Int      @default(0)
  shopId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  shop          shop     @relation(fields: [shopId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([revieweeEmail, shopId])
  @@index([revieweeName, revieweeEmail, rating])
}
